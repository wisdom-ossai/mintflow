# Flowra API — copy to .env and fill in values.
# Never commit real secrets.

APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_ORIGINS=http://localhost:4444,http://localhost:3000
SCHEDULER_ENABLED=true
TRIAL_DAYS=7

# Supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=
# JWT Secret from Dashboard → Settings → API (required in production)
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql+asyncpg://postgres:PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Plaid
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_WEBHOOK_URL=https://api.flowra.app/v1/accounts/plaid/webhook

# Anthropic
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514

# Firebase (optional locally)
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json

# RevenueCat — Authorization header value configured on the RC webhook
REVENUECAT_WEBHOOK_SECRET=
REVENUECAT_ENTITLEMENT_GROWTH=growth
REVENUECAT_ENTITLEMENT_PRO=pro

# Observability
SENTRY_DSN=
