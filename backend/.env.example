# Flowra API — copy to .env and fill in.
# Never commit real secrets.

APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
ALLOWED_ORIGINS=http://localhost:4444,http://localhost:3000
SCHEDULER_ENABLED=true
TRIAL_DAYS=7
APP_PUBLIC_URL=http://localhost:3000
APP_DEEP_LINK_RESET=flowra://reset-password

# Railway Postgres (prod) or local docker-compose:
# DATABASE_URL=postgresql+asyncpg://flowra:flowra@localhost:5432/flowra
DATABASE_URL=postgresql+asyncpg://postgres:PASSWORD@HOST:5432/railway

# JWT
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# Google Sign-In (Web client ID as primary audience; add iOS/Android IDs comma-separated)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_IDS=

# Resend
RESEND_API_KEY=
EMAIL_FROM=Flowra <noreply@flowra.app>

# Plaid
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_WEBHOOK_URL=https://api.flowra.app/v1/accounts/plaid/webhook

# Anthropic
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514

# Firebase
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json

# RevenueCat
REVENUECAT_WEBHOOK_SECRET=
REVENUECAT_ENTITLEMENT_GROWTH=growth
REVENUECAT_ENTITLEMENT_PRO=pro

# Leave empty to disable Sentry
SENTRY_DSN=
