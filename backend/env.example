# ─── App ───────────────────────────────────────────────
APP_ENV=development
APP_NAME=Flowra API
APP_VERSION=1.0.0
SECRET_KEY=your-secret-key-min-32-chars-change-in-prod
ALLOWED_ORIGINS=http://localhost:3000,https://flowra.app

# ─── Supabase ──────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql+asyncpg://postgres:password@db.your-project.supabase.co:5432/postgres

# ─── Plaid ─────────────────────────────────────────────
PLAID_CLIENT_ID=your-plaid-client-id
PLAID_SECRET=your-plaid-secret
PLAID_ENV=sandbox   # sandbox | development | production
PLAID_WEBHOOK_URL=https://api.flowra.app/v1/plaid/webhook

# ─── Anthropic (Claude) ────────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-api-key
CLAUDE_MODEL=claude-sonnet-4-20250514

# ─── Firebase ──────────────────────────────────────────
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json

# ─── RevenueCat ────────────────────────────────────────
REVENUECAT_WEBHOOK_SECRET=your-revenuecat-webhook-secret

# ─── Stripe ────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your-stripe-secret
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret

# ─── Sentry ────────────────────────────────────────────
SENTRY_DSN=https://your-sentry-dsn

# ─── Rate limiting ─────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
