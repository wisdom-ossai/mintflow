# Client-only env for the Flutter app.
# NEVER put service_role, DATABASE_URL, or Stripe secret keys here —
# they ship inside the app bundle via pubspec assets.

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key-from-supabase-settings-api

# Optional
REVENUECAT_API_KEY=
API_BASE_URL=https://api.flowra.app
