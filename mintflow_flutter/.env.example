# Client-only env for the Flutter app.
# This file is bundled in the IPA via pubspec assets — NEVER put
# DATABASE_URL, SECRET_KEY, Plaid/Stripe/Anthropic secrets, or
# service_role keys here.

API_BASE_URL=https://api.mintflow.app

# Web OAuth client ID (same as backend GOOGLE_CLIENT_ID) — used as
# GoogleSignIn serverClientId so the id_token audience matches the API.
GOOGLE_CLIENT_ID=

# iOS OAuth client ID (Google Cloud → iOS client, bundle app.mintflow.ios).
# Info.plist GIDClientID / URL scheme must match this client; otherwise sign-in
# aborts the iOS process. Recreate the iOS client after changing the bundle ID.
GOOGLE_IOS_CLIENT_ID=

# Public SDK key only (appl_ / goog_ / test_). Never the webhook secret.
REVENUECAT_API_KEY=
