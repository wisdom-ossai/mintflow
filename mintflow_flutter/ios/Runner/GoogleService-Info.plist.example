<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Copy to GoogleService-Info.plist (gitignored) from Firebase Console:
  Project Settings → Your iOS app (Bundle ID app.mintflow.ios) → Download.
  Then upload an APNs Auth Key (.p8) under Cloud Messaging → Apple app configuration.
-->
<plist version="1.0">
<dict>
	<key>CLIENT_ID</key>
	<string>REPLACE.apps.googleusercontent.com</string>
	<key>REVERSED_CLIENT_ID</key>
	<string>com.googleusercontent.apps.REPLACE</string>
	<key>API_KEY</key>
	<string>REPLACE</string>
	<key>GCM_SENDER_ID</key>
	<string>REPLACE</string>
	<key>PLIST_VERSION</key>
	<string>1</string>
	<key>BUNDLE_ID</key>
	<string>app.mintflow.ios</string>
	<key>PROJECT_ID</key>
	<string>mintflow-app</string>
	<key>STORAGE_BUCKET</key>
	<string>mintflow-app.appspot.com</string>
	<key>IS_ADS_ENABLED</key>
	<false/>
	<key>IS_ANALYTICS_ENABLED</key>
	<false/>
	<key>IS_APPINVITE_ENABLED</key>
	<true/>
	<key>IS_GCM_ENABLED</key>
	<true/>
	<key>IS_SIGNIN_ENABLED</key>
	<true/>
	<key>GOOGLE_APP_ID</key>
	<string>1:REPLACE:ios:REPLACE</string>
</dict>
</plist>
